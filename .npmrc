# ~/.npmrc
#
# NOTE ON COMMENTS: npm's ini parser accepts `;` and `#` only. This file used
# `//` for its comments, which npm does NOT treat as a comment — it parsed each
# of those lines as a config KEY set to `true` and warned:
#   "Unknown config '// GitHub Package Registry setup'. This will stop working
#    in the next major version of npm."
# (verified with `npm config list` against a sandbox npmrc on npm 11.16.0).
# Hence: `#`.

# GitHub Package Registry, for my own @bnb-scoped packages.
#
# This is a SCOPED registry, so it only affects packages under @bnb/. Everything
# else still resolves against registry.npmjs.org and installs fine on a fresh,
# unauthenticated machine (verified: `npm view is-odd` succeeds with this file
# active). Installing an @bnb/* package DOES require a GitHub token — without
# one, GitHub Packages answers 404 even for public packages — but nothing here
# needs a token until you actually depend on an @bnb/* package.
@bnb:registry=https://npm.pkg.github.com/

# `npm init -y` defaults.
#
# These were previously spelled init.author.name / init.author.email /
# init.license. That dotted form is a deprecated alias: it still works today
# (verified with `npm init -y`) but npm prints
#   "npm warn config init.author.name Use `--init-author-name` instead."
# on EVERY npm invocation. The dashed spelling below is the canonical one and
# is warning-free. Keep these in sync with configs/zsh/general/config-npm.sh.
init-author-name=Tierney Cyren
init-author-email=hello@bnb.im
init-license=MIT
init-version=0.0.1
