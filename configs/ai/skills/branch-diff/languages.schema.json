{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "branch-diff languages",
  "description": "Shiki language ids whose grammars the viewer can highlight. Anything else shows as plain text.",
  "type": "object",
  "required": ["languages"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "languages": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9+#.-]*$" },
      "uniqueItems": true
    }
  }
}
