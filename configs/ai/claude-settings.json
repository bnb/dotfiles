{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeGitInstructions": false,
  "permissions": {
    "allow": [
      "Bash(git worktree remove *)",
      "Bash(git branch -d *)",
      "Bash(git stash drop *)",
      "Bash(cargo clean)",
      "Bash($HOME/.claude/skills/repo-cleanup/scripts/cleanup.py *)",
      "Bash($HOME/.agents/skills/repo-cleanup/scripts/cleanup.py *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Bash(git commit *--no-verify*)",
      "Bash(git worktree remove *--force*)",
      "Bash(git worktree remove* -f*)",
      "Bash(git branch -d *--force*)",
      "Bash(git branch -d* -f*)",
      "Bash(git branch -d* -D*)",
      "Bash(gh pr merge *--admin*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/no-em-dashes.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/no-secret-reads.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/no-forced-git.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
