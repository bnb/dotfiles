# ~/.gitconfig — portable settings
#
# This file is committed to the dotfiles repo and symlinked to ~/.gitconfig by
# setup.sh, so every line has to work unmodified on macOS, Linux and WSL.
# Anything that depends on a particular machine lives in ~/.gitconfig.local,
# which setup.sh generates and which is included at the bottom of this file.

[user]
	name = Tierney Cyren
	email = hello@bnb.im
	username = bnb

[core]
	# nano ships with macOS and with essentially every Linux/WSL base image, so
	# this is safe to keep portable. Override it in ~/.gitconfig.local on any
	# machine where it is missing or where you want something else.
	editor = nano

[color]
	ui = auto

[github]
	user = bnb

[init]
	defaultBranch = main

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

# Machine-specific settings (commit signing, work identity overrides) live here.
# setup.sh writes it; git silently ignores the include when the file is absent.
#
# Keep this last: includes are expanded in place, so anything in the local file
# overrides the defaults above.
[include]
	path = ~/.gitconfig.local
