# ~/.gitconfig — portable settings
#
# This file is committed to the dotfiles repo and [include]d by the small
# ~/.gitconfig that setup.sh writes, so every line has to work unmodified on
# macOS, Linux and WSL. Anything that depends on a particular machine lives in
# ~/.gitconfig.local, which setup.sh generates and which is included near the
# bottom of this file. `git config --global` writes land in ~/.gitconfig after
# that include, so they beat both files.

[user]
	name = Tierney Cyren
	email = hello@bnb.im
	username = bnb

[core]
	# nano ships with macOS and with essentially every Linux/WSL base image, so
	# this is safe to keep portable. Override it in ~/.gitconfig.local on any
	# machine where it is missing or where you want something else.
	editor = nano

[color]
	ui = auto

[github]
	user = bnb

[init]
	defaultBranch = main

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

# Machine-specific settings (commit signing, mostly) live here. setup.sh writes
# it; git silently ignores the include when the file is absent.
#
# Keep this after everything but the work includes below: includes are expanded
# in place, so anything in the local file overrides the defaults above.
[include]
	path = ~/.gitconfig.local

# Work repos commit, sign and push as tierney@assistant-ui.com: anything under
# ~/GitHub/assistant-ui, and any repo with a remote in the assistant-ui org
# wherever it's cloned. They come after the local file so the work signing key
# beats the personal one. The path is relative to this file, in the repo.
[includeIf "gitdir:~/GitHub/assistant-ui/"]
	path = configs/git/assistant-ui.gitconfig
[includeIf "hasconfig:remote.*.url:git@github.com:assistant-ui/**"]
	path = configs/git/assistant-ui.gitconfig
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/assistant-ui/**"]
	path = configs/git/assistant-ui.gitconfig
[includeIf "hasconfig:remote.*.url:https://github.com/assistant-ui/**"]
	path = configs/git/assistant-ui.gitconfig
